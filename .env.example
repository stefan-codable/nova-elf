# Schlüssel für die Claude API (https://platform.claude.com). Ohne Schlüssel läuft
# die Notizerfassung, nur Analyse und Foto-Auswertung sind dann abgeschaltet.
ANTHROPIC_API_KEY=

# Optional: anderer Ablageort für die Daten (Standard: ./data)
# NOVA_ELF_DATA=/Users/<name>/Documents/nova-elf-daten

# Optional: Port des lokalen Servers (Standard: 4311)
# PORT=4311
